<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnityBestPractices.Analyzers</AssemblyName>
    <RootNamespace>UnityBestPractices.Analyzers</RootNamespace>
    <PackageId>UnityBestPractices.Analyzers</PackageId>
    <Version>0.1.0</Version>
    <Authors>UnityBestPractices contributors</Authors>
    <Description>Hidden Roslyn diagnostics and quick fixes for Unity best practices.</Description>
    <PackageTags>unity;roslyn;analyzer;codefix</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The release analyzer cannot statically follow descriptors created by the data-driven quick-fix registry. -->
    <NoWarn>$(NoWarn);RS1022;RS2003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity's Roslyn host guidance requires netstandard2.0 with Roslyn 3.8.
         A netstandard2.0 analyzer is compatible with Unity's netstandard2.1 player profile. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\README.ja.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\README.fa.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>
</Project>
