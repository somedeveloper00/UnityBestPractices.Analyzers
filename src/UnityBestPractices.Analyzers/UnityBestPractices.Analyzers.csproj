<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>UnityBestPractices.Analyzers</AssemblyName>
    <RootNamespace>UnityBestPractices.Analyzers</RootNamespace>
    <PackageId>UnityBestPractices.Analyzers</PackageId>
    <Version>0.4.26</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>UnityBestPractices contributors</Authors>
    <Description>Roslyn analyzers and quick fixes for Unity C# performance, Burst, Jobs, DOTS/ECS, and best practices in Rider and Visual Studio.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/somedeveloper00/UnityBestPractices.Analyzers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/somedeveloper00/UnityBestPractices.Analyzers.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>unity;unity3d;roslyn;analyzer;code-fix;code-analysis;csharp;performance;burst;jobs;dots;ecs;rider;visual-studio</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/somedeveloper00/UnityBestPractices.Analyzers/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The release analyzer cannot statically follow descriptors created by the central data-driven catalog.
         Catalog/release consistency is enforced by the repository validation tests instead. -->
    <NoWarn>$(NoWarn);RS1022;RS2002;RS2003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity's Roslyn host guidance requires netstandard2.0 with Roslyn 3.8.
         A netstandard2.0 analyzer is compatible with Unity's netstandard2.1 player profile. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(OutputPath)$(AssemblyName).pdb"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\..\README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\README.ja.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\README.fa.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\README.ru.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\LICENSE"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="..\..\CHANGELOG.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>
</Project>
